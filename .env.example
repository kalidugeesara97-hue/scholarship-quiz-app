# Gemini API Key (Google AI Studio එකෙන් ලබාගන්න)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Service Account Credentials (Base64 encoded JSON key)
# 1. Google Cloud Console → Service Accounts → Create Key (JSON)
# 2. Terminal: base64 -i service-account-key.json | tr -d '\n'
# 3. Output එක මෙතන paste කරන්න
GOOGLE_SHEETS_CREDENTIALS=base64_encoded_service_account_json

# Google Sheet ID (Sheet URL එකේ /d/ ට පසු ඇති ID)
# Example: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Base URL (Vercel deploy URL)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Telegram Bot (Optional — bot automation සඳහා)
# 1. Telegram → @BotFather → /newbot → token ලබාගන්න
# 2. Bot එක group එකට add කරන්න
# 3. https://api.telegram.org/bot<TOKEN>/getUpdates → chat ID ලබාගන්න
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_group_chat_id

# WhatsApp Automated Notification (Optional — උදා: Green-API / UltraMsg / CallMeBot)
# Green-API හෝ UltraMsg API URL සහ Chat ID ඇතුළත් කරන්න (නැතිනම් Web App එකේ 1-Click WhatsApp Share button එක භාවිතා කළ හැක)
WHATSAPP_API_URL=https://api.green-api.com/waInstanceXXXXX/sendMessage/XXXXX
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_CHAT_ID=1203630XXXX@g.us

# Cron Security (random string — Vercel Dashboard Settings → Environment Variables)
CRON_SECRET=your_random_cron_secret_here
